# NezhaCyberEDR R8 / ProGuard Keep Rules

# Keep Kotlinx Serialization models
-keepclassmembers class * {
    @kotlinx.serialization.Serializable *;
}
-keepclassmembers class * implements kotlinx.serialization.KSerializer {
    public static ** INSTANCE;
}
-keep,allowobfuscation class *$$serializer { *; }

# Keep NezhaEDR Data Models and YAML Rule Schemas
-keep class xin.ctkqiang.nezhaedr.data.model.** { *; }
-keep class xin.ctkqiang.nezhaedr.data.parser.** { *; }
-keep class xin.ctkqiang.nezhaedr.data.local.** { *; }
-keep class xin.ctkqiang.nezhaedr.containment.** { *; }
-keep class xin.ctkqiang.nezhaedr.data.repository.RemoteRuleCatalogItem { *; }

# Keep ViewModel and Compose UI States
-keep class xin.ctkqiang.nezhaedr.ui.main.MainViewModel { *; }
-keep class xin.ctkqiang.nezhaedr.ui.main.MainUiState { *; }

# Keep VpnService and Background Telemetry Receivers
-keep class xin.ctkqiang.nezhaedr.service.telemetry.NezhaVpnService { *; }
-keep class xin.ctkqiang.nezhaedr.service.telemetry.PackageTelemetryReceiver { *; }
