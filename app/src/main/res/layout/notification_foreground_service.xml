<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#0D1117"
    android:padding="12dp">

    <ImageView
        android:id="@+id/notif_service_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_power"
        android:tint="#10B981"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_service_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_service_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vpn_status_active"
            android:textColor="#34D399"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_service_status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#064E3B"
        android:text="@string/vector_status_active"
        android:textColor="#10B981"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp" />
</LinearLayout>
